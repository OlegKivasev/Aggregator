NODE_ENV=production
PORT=3000
STATE_DIR=/var/lib/autoservice-aggregator
# Optional base64-encoded 32-byte key from the deployment secret manager.
# When configured, successfully verified runtime supplier credentials are encrypted in STATE_DIR.
SUPPLIER_CREDENTIALS_ENCRYPTION_KEY=

# Armtek WebService. Credentials may instead be entered at runtime.
ARMTEK_API_BASE_URL=https://ws.armtek.ru/api
ARMTEK_LOGIN=
ARMTEK_PASSWORD=
# Optional account identifiers. If omitted, valid values discovered from the API are cached in STATE_DIR.
ARMTEK_VKORG=
ARMTEK_KUNNR_RG=
ARMTEK_KUNNR_ZA=
ARMTEK_INCOTERMS=
ARMTEK_VBELN=
ARMTEK_PROGRAM=
ARMTEK_REQUEST_TIMEOUT_MS=15000
ARMTEK_SEARCH_TIMEOUT_MS=60000

# Overall deadline for any supplier authorization operation.
SUPPLIER_AUTHORIZATION_TIMEOUT_MS=60000

# Rossko official SOAP API. K1 and K2 are entered at runtime.
ROSSKO_API_REQUEST_TIMEOUT_MS=15000
ROSSKO_SEARCH_TIMEOUT_MS=30000

# PartKOM credentials are entered at runtime.
PARTKOM_SEARCH_TIMEOUT_MS=15000

# Forum-Auto REST API credentials are entered at runtime.
FORUM_AUTO_SEARCH_TIMEOUT_MS=15000

# STParts ABCP public API credentials. Credentials may instead be entered at runtime.
STPARTS_API_URL=https://stpartsru.public.api.abcp.ru/
STPARTS_API_LOGIN=
STPARTS_API_PASSWORD=
STPARTS_SEARCH_TIMEOUT_MS=10000

# Legacy STParts browser diagnostics; not used by the production API adapter.
STPARTS_BASE_URL=https://stparts.ru/
STPARTS_BROWSER_PATH=
STPARTS_NAVIGATION_TIMEOUT_MS=15000
STPARTS_SETTLED_TIMEOUT_MS=4000
STPARTS_POST_COMMIT_DELAY_MS=300
STPARTS_SESSION_PROBE_TIMEOUT_MS=5000

# MotorDetal credentials are entered at runtime. Tokens are stored in STATE_DIR.
MOTORDETAL_BASE_URL=https://sales.motordetal.ru/
MOTORDETAL_REQUEST_TIMEOUT_MS=15000
MOTORDETAL_SEARCH_TIMEOUT_MS=15000

# Mladov credentials are entered at runtime. Browser state is stored in STATE_DIR.
MLADOV_BASE_URL=https://mladov.ru/
MLADOV_BROWSER_PATH=
MLADOV_NAVIGATION_TIMEOUT_MS=15000
MLADOV_SEARCH_TIMEOUT_MS=20000
